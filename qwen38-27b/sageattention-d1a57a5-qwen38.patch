+// llama.cpp supplies an explicit contiguous F16 [query][KV] mask because its
+// padded/circular cache indices do not always match bottom-right causal
+// coordinates.  Qwen3.8 uses only 0 and -INF values here; preserve the fast
+// SageAttention math while honoring every physical cache cell exactly.
+template <uint32_t num_tiles_q, uint32_t num_tiles_k, typename DTypeQKAccum>
+__device__ __forceinline__ void apply_qwen38_ggml_mask(
+    const uint32_t &Q_idx_lane_base,
+    const uint32_t &K_idx_lane_base,
+    DTypeQKAccum RS[][num_tiles_k][8],
+    const half *mask,
+    const uint32_t mask_stride_q,
+    const uint32_t qo_len,
+    const uint32_t kv_len)
+{
+#pragma unroll
+  for (uint32_t fq = 0; fq < num_tiles_q; fq++)
+  {
+#pragma unroll
+    for (uint32_t fk = 0; fk < num_tiles_k; fk++)
+    {
+#pragma unroll
+      for (uint32_t k = 0; k < 8; k++)
+      {
+        const uint32_t q_idx = Q_idx_lane_base + fq * 16 + 8 * ((k % 4) / 2);
+        const uint32_t kv_idx = K_idx_lane_base + fk * 16 + 8 * (k / 4) + k % 2;
+        bool masked = q_idx >= qo_len || kv_idx >= kv_len;
+        if (!masked)
+        {
+          const float mask_value = __half2float(mask[q_idx * mask_stride_q + kv_idx]);
+          masked = !isfinite(mask_value) || mask_value < -10000.0f;
+        }
+        if constexpr (std::is_same<DTypeQKAccum, float>::value)
+        {
+          RS[fq][fk][k] = masked ? -5000000.0f : RS[fq][fk][k];
+        }
+        else if constexpr (std::is_same<DTypeQKAccum, half>::value)
+        {
+          RS[fq][fk][k] = masked ? __float2half_rn(-50000.0f) : RS[fq][fk][k];
+        }
+      }
+    }
+  }
+}
+
+// A single-sequence llama.cpp causal mask is a finite prefix followed by an
+// infinite suffix.  Its prefix length carries all the information Sage needs,
+// including padding at the end of the physical cache.  Applying these compact
+// limits only to the one or two boundary K tiles preserves Sage's native
+// causal tile skipping instead of evaluating every future tile and masking it
+// afterwards.
+template <uint32_t num_tiles_q, uint32_t num_tiles_k, typename DTypeQKAccum>
+__device__ __forceinline__ void apply_qwen38_ggml_limits(
+    const uint32_t &Q_idx_lane_base,
+    const uint32_t &K_idx_lane_base,
+    DTypeQKAccum RS[][num_tiles_k][8],
+    const int *limits,
+    const uint32_t qo_len,
+    const uint32_t kv_len)
+{
+#pragma unroll
+  for (uint32_t fq = 0; fq < num_tiles_q; fq++)
+  {
+#pragma unroll
+    for (uint32_t fk = 0; fk < num_tiles_k; fk++)
+    {
+#pragma unroll
+      for (uint32_t k = 0; k < 8; k++)
+      {
+        const uint32_t q_idx = Q_idx_lane_base + fq * 16 + 8 * ((k % 4) / 2);
+        const uint32_t kv_idx = K_idx_lane_base + fk * 16 + 8 * (k / 4) + k % 2;
+        const bool masked = q_idx >= qo_len || kv_idx >= kv_len ||
+          (q_idx < qo_len && kv_idx >= uint32_t(limits[q_idx]));
+        if constexpr (std::is_same<DTypeQKAccum, float>::value)
+        {
+          RS[fq][fk][k] = masked ? -5000000.0f : RS[fq][fk][k];
+        }
+        else if constexpr (std::is_same<DTypeQKAccum, half>::value)
+        {
+          RS[fq][fk][k] = masked ? __float2half_rn(-50000.0f) : RS[fq][fk][k];
+        }
+      }
+    }
+  }
+}
